<% layout('layout/boilerplates') %>

<div class="container mt-5" style="max-width: 600px;">
    <div class="text-center mb-4">
        <div class="card hero-card px-4 py-3 mb-4 text-center">
            <h2 class="fw-bold mb-0">ルーム入室中</h2>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="card-title"><i class="bi bi-info-circle me-2 text-primary"></i>このアプリについて</h5>
            <p class="card-text text-muted small">
                参加者はAIと1対1で対話を行い、テーマに対する自分の考えを整理します。
                全員の対話が完了したら、AIが各参加者の意見をもとに議論を行います。
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-4 border-primary">
        <div class="card-body p-4">
            <h5 class="card-title text-primary"><i class="bi bi-people me-2"></i>参加状況</h5>
            <p class="card-text text-muted small">現在ロビーに参加している人数です</p>
            <h2 class="text-center fw-bold">
                <span id="count" style="color: #f0f0f0;">0</span>
                <span style="color: #6fa8f5;"> / <span id="max">-</span></span>
                <span class="fs-5 text-muted"> 人が参加中</span>
            </h2>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <h5 class="card-title"><i class="bi bi-hourglass-split me-2 text-warning"></i>開始待ち</h5>
            <p class="card-text text-muted small">ホストが開始ボタンを押すとAIインタビューに移行します</p>
            <%- partial('partials/waveWaiting') %>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
    <div id="errorToast" class="toast align-items-center border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="errorToastMessage">
                <i class="bi bi-exclamation-triangle me-2"></i><span id="errorToastText"></span>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const roomId = '<%= roomId %>';

    socket.on('connect', () => {
        socket.emit('joinRoom', roomId);
    });

    socket.on('updateCount', (count, max) => {
        document.getElementById('count').textContent = count;
        document.getElementById('max').textContent = max;
    });

    function showError(message) {
        document.getElementById('errorToastText').textContent = message;
        const toast = new bootstrap.Toast(document.getElementById('errorToast'));
        toast.show();
    }

    // dialogページに遷移する際にソケットIDとルームIDを渡す
    socket.on('redirect', (url) => {
        window.location.href = url + '?socketId=' + socket.id + '&roomId=' + '<%= roomId %>';
    });

    // ルームが満員の時の処理
    socket.on('roomFull', () => {
        showError('このルームは満員です。参加できません。');
        setTimeout(() => {
            window.location.href = '/';
        }, 2000);
    });
</script>